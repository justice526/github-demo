# 环境变量示例（占位值，仅用于说明可用配置；复制为 .env 后填入真实值）
# 生产部署必须通过环境变量注入强随机密钥，切勿把真实 .env 提交进版本库。
# 注意：.env 已在 .gitignore 中，不会被提交；本文件 .env.example 可以提交。

# ===== 认证与安全 =====
# 访问令牌签名密钥（HS256）。生产必须替换为强随机值，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# 访问令牌寿命（秒），默认 1800（30 分钟）
ACCESS_TTL=1800

# 刷新令牌寿命（秒），默认 604800（7 天）
REFRESH_TTL=604800

# ===== 限流（按客户端 IP 固定窗口）=====
# 单 IP 每窗口允许的最大请求数
RATE_LIMIT=600
# 限流窗口（秒）
RATE_WINDOW=60

# ===== CORS（跨域白名单）=====
# 允许的来源，逗号分隔；例如：https://app.example.com,https://admin.example.com
# 留空表示仅同源（不暴露跨域头）。生产切勿使用通配符。
CORS_ORIGIN=
